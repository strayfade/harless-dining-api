{
  "name": "harless-dining-api",
  "version": "0.1.0",
  "description": "Unofficial menu client for Marshall University's Harless Dining Hall (Sodexo). Get Breakfast / Lunch / Dinner for any date, with stations, nutrition, and allergens.",
  "keywords": [
    "marshall-university",
    "harless",
    "dining-hall",
    "sodexo",
    "menu",
    "nutrition",
    "allergens"
  ],
  "license": "MIT",
  "author": "Noah",
  "repository": {
    "type": "git",
    "url": "https://github.com/strayfade/harless-dining-api.git"
  },
  "homepage": "https://github.com/strayfade/harless-dining-api#readme",
  "bugs": "https://github.com/strayfade/harless-dining-api/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "cross-env HARLESS_LIVE=1 vitest run",
    "example:basic": "tsx examples/basic.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "cross-env": "^7.0.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
